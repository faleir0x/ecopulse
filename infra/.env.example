# Copie para infra/.env e ajuste se alguma porta já estiver em uso na sua máquina.
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
API_PORT=8000
REALTIME_PORT=8002
# Fonte do serviço environment: open-meteo (real), simulador ou simulador-calor (demo)
AMBIENTE_FONTE=open-meteo
# Chave do OpenRouteService (rotas seguras, etapa 5.5): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Cloudflare Tunnel (docker compose --profile tunel up -d cloudflared)
CLOUDFLARE_TUNNEL_TOKEN=

# Produção na VPS (docker-compose.prod.yml): hosts com DNS apontando para a VPS
# API_HOST=api.exemplo.com
# RT_HOST=rt.exemplo.com
# ACME_EMAIL=voce@exemplo.com
# ECOPULSE_TAG=main
