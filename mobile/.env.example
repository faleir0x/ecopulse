# Copie para .env.local. Sem nada, o app usa o IP do laptop (o mesmo do Metro) com as portas abaixo.
EXPO_PUBLIC_API_PORT=8000
EXPO_PUBLIC_WS_PORT=8002
# Ou URLs completas:
# EXPO_PUBLIC_API_URL=http://192.168.0.12:8000
# EXPO_PUBLIC_WS_URL=ws://192.168.0.12:8002
# Demo/apresentação: posição fixa ("lat,lon") ou trajeto percorrido sozinho ("lat,lon;lat,lon;..."),
# sem usar o GPS. Ex.: Av. Paulista, onde o infra/demo/semear.py cria ocorrências.
# EXPO_PUBLIC_LOCALIZACAO_SIMULADA=-23.5480,-46.6440;-23.5550,-46.6500;-23.5613,-46.6565
# EXPO_PUBLIC_VELOCIDADE_SIMULADA=12   # m/s ao percorrer o trajeto
